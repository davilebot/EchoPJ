# Ambiente exclusivo da aplicacao SaaS. Nunca reutilize o arquivo de segredos
# nem o volume /data da aplicacao atual.

# Pode apontar para o mesmo PostgreSQL somente leitura da Receita usado pela v1.
POSTGRES_DSN=postgresql://USUARIO_SOMENTE_LEITURA:SENHA@HOST:5432/cnpj

# Bootstrap temporario, ate a autenticacao SaaS substituir estas variaveis.
APP_USERNAME=admin@example.com
APP_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# URL exclusiva da v2. Convites gerados pela v2 usam esta origem.
APP_PUBLIC_URL=https://saas.seudominio.com.br

# Estes caminhos ficam no volume exclusivo /srv/echopjs-saas-v2/data.
AUTH_DATABASE_PATH=/data/auth.sqlite
SAAS_DATABASE_PATH=/data/saas.sqlite
JOB_DATABASE_PATH=/data/jobs.sqlite
WEBSITE_CACHE_PATH=/data/website-cache.sqlite

AUTH_SESSION_DAYS=30
WEBSITE_TIMEOUT_SECONDS=3
WEBSITE_WORKERS=10
DATABASE_WORKERS=8
DATABASE_STATEMENT_TIMEOUT_MS=1800
MAX_BATCH_SIZE=200
MAX_JOB_SIZE=10000

# A organização interna da Echo usa créditos ilimitados. As demais começam com
# o saldo de avaliação e depois recebem créditos via eventos de pagamento.
SAAS_INTERNAL_ORGANIZATION_ID=1
SAAS_INTERNAL_ORGANIZATION_NAME=EchoHub
SAAS_TRIAL_CREDITS=100

# Identidade e versões dos documentos aprovados. Enquanto qualquer campo ficar
# vazio, as páginas aparecem como rascunho e o cadastro público permanece fechado.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_DOCUMENT=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
LEGAL_EFFECTIVE_DATE=
LEGAL_RETENTION_POLICY=

# O piloto usa links copiados manualmente.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
