# Credencial administrativa exclusiva para construir tabelas shadow e realizar
# a troca atomica. Nunca use a credencial somente leitura da aplicacao.
ADMIN_POSTGRES_DSN=postgresql://USUARIO_ADMIN:SENHA@postgres:5432/cnpj

# Compartilhamento publico oficial do CNPJ da Receita Federal.
RFB_OFFICIAL_SHARE_URL=https://arquivos.receitafederal.gov.br/index.php/s/YggdBLfdninEJX9

RFB_UPDATE_STATUS_PATH=/state/status.json
RFB_UPDATE_MANIFEST_DIR=/state/manifests
RFB_UPDATE_CACHE_DIR=/cache
RFB_MANIFEST_STABILITY_HOURS=18
RFB_MINIMUM_SHARDS=10
RFB_MINIMUM_FREE_GB=12
RFB_MAXIMUM_DATABASE_GB=175
RFB_EXPECTED_GROWTH_FACTOR=1.10

# Ative somente depois da migracao das tabelas auxiliares antigas para as
# views de compatibilidade. Mantem cada rollback por no minimo sete dias.
RFB_AUTO_RETIRE_ROLLBACKS=false
RFB_ROLLBACK_DAYS=7

RFB_JOB_DATABASE_PATHS=/app-data/jobs.sqlite,/legacy-data/jobs.sqlite
RFB_READINESS_URLS=http://echopjs-saas_v2_app:8000/health/ready,http://plataforma-receita_matcher_app:8000/health
