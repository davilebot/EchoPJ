# Copie para .env e preencha apenas na sua máquina. Não use credenciais de produção.
# É necessário um PostgreSQL com o schema e uma amostra compatível da Receita.
POSTGRES_DSN=postgresql://USUARIO:SENHA@127.0.0.1:5432/cnpj
APP_USERNAME=dev@example.com
APP_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL_FORTE
APP_PUBLIC_URL=https://localhost:8000

AUTH_DATABASE_PATH=./data/auth.sqlite
SAAS_DATABASE_PATH=./data/saas.sqlite
JOB_DATABASE_PATH=./data/jobs.sqlite
WEBSITE_CACHE_PATH=./data/website-cache.sqlite
AUTH_SESSION_DAYS=30
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_SIGNUP_VERIFICATION_HOURS=24
SAAS_TRIAL_CREDITS=100
SAAS_LOW_CREDIT_THRESHOLD=20
SAAS_SELF_SIGNUP_ENABLED=false

# O cadastro público só abre quando todos os dados jurídicos abaixo estiverem
# preenchidos e as versões corresponderem aos documentos aprovados.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_DOCUMENT=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
LEGAL_EFFECTIVE_DATE=
LEGAL_RETENTION_POLICY=
WEBSITE_TIMEOUT_SECONDS=3
WEBSITE_WORKERS=10
DATABASE_WORKERS=8
DATABASE_STATEMENT_TIMEOUT_MS=1800
MAX_BATCH_SIZE=200
MAX_JOB_SIZE=10000
SAAS_HEAVY_REQUESTS_PER_MINUTE=30
SAAS_MAX_ACTIVE_JOBS_PER_ORGANIZATION=5
SAAS_MAX_REQUEST_BYTES=16777216
SAAS_BACKUP_STATUS_PATH=./data/backup-status.json
SAAS_OFFSITE_BACKUP_CONFIGURED=false
SAAS_EXTERNAL_ALERTS_CONFIGURED=false

# Cobrança: mantenha desativada até concluir a homologação Sandbox e cadastrar
# um catálogo JSON válido. Nunca use a API Key como token do webhook.
SAAS_BILLING_ENABLED=false
SAAS_BILLING_PROVIDER=asaas
SAAS_BILLING_CATALOG_JSON=[]
SAAS_BILLING_EMAIL_NOTIFICATIONS_ENABLED=false
SAAS_BILLING_EMAIL_INTERVAL_MINUTES=360
ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT_SECONDS=12

# Opcional: envio de convites por e-mail. Vazio mantém o compartilhamento por link.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
