[Unit]
Description=Atualizacao automatica mensal da base CNPJ da Receita
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/easypanel/secrets/echopjs-rfb-updater/updater.env

[Service]
Type=oneshot
ExecStart=/opt/echopjs-saas-v2/ops/run_rfb_auto_update.sh
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/echopjs-saas-v2/rfb-updater /srv/radar-cnpj/tmp/rfb-auto-update

[Install]
WantedBy=multi-user.target
